# Root .gitignore for the NCAA aviation projects
# Keep source code, documentation, and dependency manifests in version control.
# Exclude local runtime artifacts, generated indexes, caches, and machine-specific files.

# Python environments and virtualenvs
**/.venv/
**/venv/
**/env/
**/ENV/
**/.venv-runtime/
**/env.bak/
**/venv.bak/

# Python bytecode and caches
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/wheelhouse/
**/*.whl
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.cache/
**/.ipynb_checkpoints/
**/htmlcov/
**/.coverage
**/.coverage.*
**/coverage.xml
**/nosetests.xml
**/*.egg-info/
**/*.egg
**/__pypackages__/
**/pip-wheel-metadata/
**/build/
**/dist/

# Node / frontend local artifacts
**/node_modules/
**/.npm/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnp.*
**/dist/
**/.parcel-cache/
**/.vite/
**/.next/
**/.nuxt/
**/.output/
**/coverage/

# User-generated exports and data files
**/*.csv
**/*.json.backup
**/dolt-secretary-records-*.csv
**/dolt-secretary-backup-*.json

# Environment variables and secrets
**/.env
**/.env.*
!.env.example
!**/.env.example
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*.secret
*.crt
*.cer
*.der
*.mobileprovision

# IDE and editor noise
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.agents/
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
desktop.ini
**/desktop.ini
*.swp
*.swo
*~

# OS generated files
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs, temp files, and scratch output
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
**/tmp/
**/temp/
**/tmp-*.txt
**/startup-out.log
**/startup-err.log
**/streamlit-debug-*.log

# Generated indexes, corpora, and local data
**/content_index/
**/vector_index/
**/database/
**/instance/
**/site/
**/coverage/

# Local databases and model artifacts
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.dump
**/*.pkl
**/*.pickle
**/*.npy
**/*.npz
**/*.parquet
**/*.feather
**/*.faiss
**/*.pt
**/*.pth
**/*.ckpt
**/*.bin
**/*.safetensors
**/*.h5
**/*.onnx
**/*.model

# Browser / desktop app local state, recovery data, and exports
**/IndexedDB/
**/Local Storage/
**/Session Storage/
**/Cache/
**/Code Cache/
**/GPUCache/
**/*-journal
**/*.jsonl
**/*.ndjson

# Operational records, user data exports, and recovery snapshots
**/Capt-Haruna-Desktop-Bundle/README_TRANSFER.txt
**/*_CHECK_ONLY.json
**/*_RESTORE_ALL_DATA.json
**/*local*before*recovery*
**/*starter_sample*.json
**/*starter*personnel*.json
**/*personnel*backup*.json
**/*records*.csv
**/*backup*.json
**/*Backup*.json
**/NCAA_DOLT_Backup_*.json
**/3_starter_personnel_backup.json
**/dolt-secretary-backup-*.json

# Archives, exports, and reference media
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.gz
*.pbix
*.pbit
*.xlsx
*.xls
*.xlsm
*.pdf
*.wav
*.mp3
*.mp4
*.avi
*.mov
*.m4a
*.flac

# Netlify CLI local state (site ID, deploy state — not needed in repo)
**/.netlify/

# Optional: keep local backup or transfer artifacts out of Git
**/*backup*
**/*Backup*

# Local test sample data
**/NCAA_DOLT_*_Test_Sample.json
